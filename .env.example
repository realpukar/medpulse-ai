# ==============================================================================
# MEDPULSE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
APP_ENV=development

# Database
# Default: SQLite (no setup required). For PostgreSQL: postgresql://user:password@localhost:5432/medpulse_ai
DATABASE_URL=sqlite:///./medpulse.db

# Security & Authentication
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=medpulse_super_secret_jwt_key_change_in_production_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional External AI API Key (Fallback uses local NLP & rule engine)
GEMINI_API_KEY=

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME="MEDPULSE AI"
NEXT_PUBLIC_DEMO_MODE=true
